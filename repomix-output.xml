<file path="src/lib/readline.ts">
import readline from "readline"

let rl: readline.Interface
const prompt = " ❯ "

export function getReadlineInterface() {
  if (!rl) {
    rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout,
    })
  }
  return rl
}

export async function ask(): Promise<string> {
  const rl = getReadlineInterface()
  return new Promise((resolve) => {
    rl.question(prompt, (answer) => {
      resolve(answer.trim())
    })
  })
}
</file>

<file path="src/lib/security.ts">
import path from "path"

export function safePath(inputPath: string): string {
  const resolved = path.resolve(inputPath)
  const cwd = process.cwd()
  const isInsideCwd = resolved.startsWith(cwd + path.sep)
  const isCwdItself = resolved === cwd

  if (!isInsideCwd && !isCwdItself) {
    throw new Error(`Access denied: path outside working directory`)
  }

  return resolved
}
</file>

